      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locally logs install / uninstall / MDM export events; exportable as CSV; never uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机记录安装/卸载/MDM 导出等操作，可导出 CSV；不上报到云端。"
          }
        }
      }
    },
    "settings.hint.automation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleScript: tell application \"启椟\" to install role \"frontend\". Shortcuts: chain Select Role + Dry-Run Install. See docs/examples/."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleScript：tell application \"Kidux\" to install role \"frontend\"。Shortcuts：串联「选择开发岗位」+「模拟安装岗位」。说明见 docs/examples/。"
          }
        }
      }
    },
    "settings.hint.brewfile" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a Brewfile, or watch a local Brewfile vs Kidux selections and suggest sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入现有 Brewfile，或监视本机 Brewfile 与 Kidux 勾选差异并建议同步（S12-07 · S18-12）"
          }
        }
      }
    },
    "settings.hint.community_refs" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows community reference links and official brew alternatives under Discover featured picks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后在发现页精选下方显示「社区资源参考」外链与官方 brew 替代"
          }
        }
      }
    },
    "settings.hint.default_layout" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the default layout for the next launch only. Switch now from Home → Immersive Chat or the toolbar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅设置下次启动时的默认界面，不会立即切换当前布局。请从首页「进入沉浸对话」或顶栏按钮切换。"
          }
        }
      }
    },
    "settings.hint.diagnostics" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export anonymized environment info, settings summary, and install history (no API keys)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出匿名化环境信息、设置摘要与安装历史，便于排查（不含 API Key）。"
          }
        }
      }
    },
    "settings.hint.extended_catalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import Catalog Schema JSON into Discover (stored locally, not shipped with the app)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入符合 Catalog Schema 的 JSON，合并到发现页（仅存本机，不随 App 分发）"
          }
        }
      }
    },
    "settings.hint.git" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes git config --global user.name / user.email. Fill once after installing Git; used for commits and drift compare. Does not log you into GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写到本机 `git config --global user.name / user.email`。新 Mac 或换机装完 Git 后，在这里填一次，之后 commit 就有正确作者信息；也用于环境漂移对比。不会替你登录 GitHub。"
          }
        }
      }
    },
    "settings.hint.git_missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git not found — install Git first"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未检测到 git，请先安装 Git"
          }
        }
      }
    },
    "settings.hint.install_history" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stores summaries of role / Discover batch installs locally only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录每次岗位或发现页批量安装的摘要，仅存本机。"
          }
        }
      }
    },
    "settings.hint.macos_defaults" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply common defaults presets (inspired by OpenBoot / zero.sh)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用常用 defaults 预设（参考 OpenBoot / zero.sh）"
          }
        }
      }
    },
    "settings.hint.multi_roles" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: single role. On: multi-select and merge tool sets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时岗位互斥单选；开启后可多选并合并工具集"
          }
        }
      }
    },
    "settings.hint.offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline mode blocks trending stats, remote icons, and app update checks. Usage frequency stays on-device as toolID counts (off by default, never uploaded)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线模式阻断热门统计、远程图标与应用更新检查。使用频率仅存本机 toolID 计数，默认关且不上报（S19-04）。"
          }
        }
      }
    },
    "settings.hint.scheduled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheduled updates install a LaunchAgent that only runs brew update + outdated scan (no auto-upgrade). Weekly digest uses local notifications for updates / drift / services."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定时更新会安装 LaunchAgent，仅执行 brew update + 可更新扫描，不会自动升级软件。健康周报通过本地通知汇总可更新/漂移/服务状态。"
          }
        }
      }
    },
    "settings.hint.share_import" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import from a share link (kidux:// / hosted JSON)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从分享链接导入（kidux:// / 同事托管 JSON）"
          }
        }
      }
    },
    "settings.hint.shell" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affects post-install config: Zsh uses Oh My Zsh; Fish writes ~/.config/fish. Does not run chsh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影响安装后配置：Zsh 使用 Oh My Zsh；Fish 则写入 ~/.config/fish（S17-12）。不会自动 chsh。"
          }
        }
      }
    },
    "settings.hint.shell_fish" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active: Fish. Oh My Zsh steps in role bundles will be replaced with Fish setup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前有效：Fish。岗位清单中的 Oh My Zsh 步骤将被替换为 Fish 配置。"
          }
        }
      }
    },
    "settings.hint.team_bundle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export roles, tool picks, and Discover selections for migration or sharing (OpenBoot-style JSON v4 with MAS/defaults/shell)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出岗位、工具选择与发现页勾选，换机或分享给同事后一键恢复（OpenBoot 式 JSON · v4 含 MAS/defaults/shell）"
          }
        }
      }
    },
    "settings.hint.time_saved" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time saved estimates ~3 minutes of manual setup per tool."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节省时间按每款约 3 分钟手工装机估算（S19-01）"
          }
        }
      }
    },
    "settings.hint.updates" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparkle checks the appcast; fallback check is a lightweight option before notarization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparkle 从更新源拉取版本；备用检测用于公证前的轻量检查。"
          }
        }
      }
    },
    "settings.hint.wrap_link" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {

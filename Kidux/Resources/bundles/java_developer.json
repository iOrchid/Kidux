{
  "id": "java_developer",
  "name": "Java 工程师",
  "description": "JDK、IntelliJ、Maven/Gradle、Spring 后端开发",
  "readme": "# Java 工程师 · 新人必读\n\n## 上手顺序\n1. JDK（注意公司要求的 LTS 版本）。\n2. IntelliJ IDEA / VS Code。\n3. Maven / Gradle。\n4. Docker 与数据库客户端。\n\n## 提示\n多 JDK 并存时用 jenv / sdkman 管理，避免 `JAVA_HOME` 混乱。\n",
  "icon": "cup.and.saucer.fill",
  "version": "1.0.0",
  "includes": [
    "_base_office"
  ],
  "tools": [
    {
      "ref": "openjdk@21",
      "required": false
    },
    {
      "ref": "intellij-idea",
      "required": false
    },
    {
      "ref": "intellij-idea-ce",
      "required": false
    },
    {
      "ref": "maven",
      "required": false
    },
    {
      "ref": "gradle",
      "required": false
    },
    {
      "ref": "docker",
      "required": false
    },
    {
      "ref": "postman",
      "required": false
    },
    {
      "ref": "insomnia",
      "required": false
    },
    {
      "ref": "mysql",
      "required": false
    },
    {
      "ref": "postgresql",
      "required": false
    },
    {
      "ref": "redis",
      "required": false
    },
    {
      "ref": "dbeaver-community",
      "required": false
    },
    {
      "ref": "tableplus",
      "required": false
    },
    {
      "ref": "kubernetes-cli",
      "required": false
    },
    {
      "ref": "starship",
      "required": false
    },
    {
      "ref": "fzf",
      "required": false
    },
    {
      "ref": "ripgrep",
      "required": false
    },
    {
      "ref": "lazygit",
      "required": false
    },
    {
      "ref": "tmux",
      "required": false
    }
  ],
  "postInstall": [
    {
      "id": "omz",
      "name": "Oh My Zsh",
      "script": "install_omz.sh",
      "skipIf": "test -d \"$HOME/.oh-my-zsh\""
    },
    {
      "id": "zsh-plugins",
      "name": "Zsh 插件",
      "script": "configure_zsh_plugins.sh",
      "skipIf": "test -d \"$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions\""
    },
    {
      "id": "starship",
      "name": "Starship 提示符",
      "script": "configure_starship.sh",
      "skipIf": "grep -q 'starship init zsh' \"$HOME/.zshrc\" 2>/dev/null"
    }
  ]
}
